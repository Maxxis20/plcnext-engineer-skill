(* generated by gen.py; the firmware's Modbus TCP client fills the WORD ports *)
A[0] := TO_INT(U00);
A[1] := TO_INT(U01);
A[2] := TO_INT(U02);
A[3] := TO_INT(U03);
A[4] := TO_INT(U04);
A[5] := TO_INT(U05);
A[6] := TO_INT(U06);
A[7] := TO_INT(U07);
A[8] := TO_INT(U08);
A[9] := TO_INT(U09);
A[10] := TO_INT(U10);
A[11] := TO_INT(U11);
A[12] := TO_INT(U12);
A[13] := TO_INT(U13);
A[14] := TO_INT(U14);
A[15] := TO_INT(U15);
A[16] := TO_INT(U16);
A[17] := TO_INT(U17);
A[18] := TO_INT(U18);
A[19] := TO_INT(U19);
A[20] := TO_INT(U20);
A[21] := TO_INT(U21);
A[22] := TO_INT(U22);
A[23] := TO_INT(U23);

(* is the price usable? *)
LINK := MB_STATE = 1;
SRC_VALID := TO_INT(R_VALID) = 1;
BEAT := TO_INT(R_BEAT);
IF BEAT <> BEAT_OLD THEN BEAT_T := 0.0; BEAT_OLD := BEAT; ELSIF BEAT_T < 9999.0 THEN BEAT_T := BEAT_T + TS; END_IF;
BEAT_OK := BEAT_T < 60.0;
VALID := LINK AND SRC_VALID AND BEAT_OK AND A[0] <> -32768;

HOUR := TO_INT(R_HOUR);
IF HOUR < 0 OR HOUR > 23 THEN HOUR := 0; VALID := FALSE; END_IF;
PRICE_TOTAL := TO_REAL(TO_INT(R_TOTAL)) / 100.0;
RANK := TO_INT(R_RANK);
TOMO_OK := TO_INT(R_TOMO_OK) = 1;
AGE_MIN := TO_INT(R_AGE);
IF A[0] = -32768 THEN PRICE := 0.0; ELSE PRICE := TO_REAL(A[0]) / 100.0; END_IF;

N_BLOCK := LIMIT(1, N_BLOCK, 12);
N_CHEAP := LIMIT(0, N_CHEAP, 24);
IF MODE < 0 OR MODE > 2 THEN MODE := 0; END_IF;
IF STRAT < 0 OR STRAT > 1 THEN STRAT := 0; END_IF;

(* the plan's clock: one step per hour. A jump of the clock (not the next hour) throws the plan away. *)
IF VALID AND HOUR <> HOUR_OLD THEN
    IF HOUR_OLD >= 0 AND HOUR <> (HOUR_OLD + 1) MOD 24 THEN PLAN_OK := FALSE; END_IF;
    HCNT := HCNT + 1;
    HOUR_OLD := HOUR;
END_IF;

SEC_T := SEC_T + TS;
IF SEC_T >= 1.0 THEN
    SEC_T := 0.0;
    (* known hours in a row, and their figures *)
    KNOWN := 0; SUM := 0.0; P_MIN := 999.0; P_MAX := -999.0; SCALE := 10.0;
    FOR I := 0 TO 23 DO
        IF A[I] <> -32768 AND KNOWN = I AND I < TO_INT(R_KNOWN) THEN
            KNOWN := I + 1;
            X := TO_REAL(A[I]) / 100.0;
            SUM := SUM + X;
            IF X > SCALE THEN SCALE := X; END_IF;
            IF X < P_MIN THEN P_MIN := X; END_IF;
            IF X > P_MAX THEN P_MAX := X; END_IF;
        END_IF;
    END_FOR;
    IF KNOWN > 0 THEN P_AVG := SUM / TO_REAL(KNOWN); ELSE P_AVG := 0.0; P_MIN := 0.0; P_MAX := 0.0; END_IF;

    (* Cheapest consecutive N_BLOCK hours among the known ones. The block is frozen once chosen, or the search
       would push it ahead for ever. Planned again: when it has run, when its length is changed, when more hours
       became known before it started (tomorrow's prices arrived), on the button. *)
    IF VALID THEN
        NEED := REPLAN OR NOT PLAN_OK OR PN <> N_BLOCK;
        IF PLAN_OK THEN
            IF HCNT >= PS + TO_DINT(PN) THEN NEED := TRUE; END_IF;
            IF HCNT < PS AND HCNT + TO_DINT(KNOWN) > PEND THEN NEED := TRUE; END_IF;
        END_IF;
        IF NEED THEN
            REPLAN := FALSE;
            PLAN_OK := FALSE;
            IF KNOWN >= N_BLOCK THEN
                BEST := 1.0E9; BI := 0;
                FOR I := 0 TO KNOWN - N_BLOCK DO
                    SUM := 0.0;
                    FOR J := I TO I + N_BLOCK - 1 DO SUM := SUM + TO_REAL(A[J]); END_FOR;
                    IF SUM < BEST THEN BEST := SUM; BI := I; END_IF;
                END_FOR;
                PS := HCNT + TO_DINT(BI);
                PN := N_BLOCK;
                PEND := HCNT + TO_DINT(KNOWN);
                P_BLOCK := BEST / TO_REAL(N_BLOCK) / 100.0;
                START_AT := (HOUR + BI) MOD 24;
                PLAN_OK := TRUE;
            END_IF;
        END_IF;
    END_IF;
    IF PLAN_OK THEN
        START_IN := MAX(0, TO_INT(PS - HCNT));
        IN_BLOCK := HCNT >= PS AND HCNT < PS + TO_DINT(PN);
        IF IN_BLOCK THEN LEFT_H := TO_INT(PS + TO_DINT(PN) - HCNT); ELSE LEFT_H := PN; END_IF;
    ELSE
        START_IN := 0; IN_BLOCK := FALSE; LEFT_H := 0;
    END_IF;

    (* which of the upcoming hours the load may run in (for the graph) *)
    FOR I := 0 TO 23 DO
        X := TO_REAL(A[I]) / 100.0;
        PLA[I] := FALSE;
        IF I < KNOWN THEN
            IF STRAT = 0 AND PLAN_OK THEN
                PLA[I] := HCNT + TO_DINT(I) >= PS AND HCNT + TO_DINT(I) < PS + TO_DINT(PN) AND X <= LIM_HIGH;
            END_IF;
            IF X <= LIM_LOW THEN PLA[I] := TRUE; END_IF;
        END_IF;
    END_FOR;
    IF STRAT = 1 AND KNOWN > 0 THEN
        PLA[0] := (RANK >= 1 AND RANK <= N_CHEAP AND PRICE <= LIM_HIGH) OR PRICE <= LIM_LOW;
    END_IF;
END_IF;

IF 0 < KNOWN THEN PT00 := TO_REAL(A[0]) / 100.0; ELSE PT00 := 0.0; END_IF; BT00 := LIMIT(0.0, PT00 / SCALE * 100.0, 100.0); PL00 := PLA[0]; HL00 := (HOUR + 0) MOD 24;
IF 1 < KNOWN THEN PT01 := TO_REAL(A[1]) / 100.0; ELSE PT01 := 0.0; END_IF; BT01 := LIMIT(0.0, PT01 / SCALE * 100.0, 100.0); PL01 := PLA[1]; HL01 := (HOUR + 1) MOD 24;
IF 2 < KNOWN THEN PT02 := TO_REAL(A[2]) / 100.0; ELSE PT02 := 0.0; END_IF; BT02 := LIMIT(0.0, PT02 / SCALE * 100.0, 100.0); PL02 := PLA[2]; HL02 := (HOUR + 2) MOD 24;
IF 3 < KNOWN THEN PT03 := TO_REAL(A[3]) / 100.0; ELSE PT03 := 0.0; END_IF; BT03 := LIMIT(0.0, PT03 / SCALE * 100.0, 100.0); PL03 := PLA[3]; HL03 := (HOUR + 3) MOD 24;
IF 4 < KNOWN THEN PT04 := TO_REAL(A[4]) / 100.0; ELSE PT04 := 0.0; END_IF; BT04 := LIMIT(0.0, PT04 / SCALE * 100.0, 100.0); PL04 := PLA[4]; HL04 := (HOUR + 4) MOD 24;
IF 5 < KNOWN THEN PT05 := TO_REAL(A[5]) / 100.0; ELSE PT05 := 0.0; END_IF; BT05 := LIMIT(0.0, PT05 / SCALE * 100.0, 100.0); PL05 := PLA[5]; HL05 := (HOUR + 5) MOD 24;
IF 6 < KNOWN THEN PT06 := TO_REAL(A[6]) / 100.0; ELSE PT06 := 0.0; END_IF; BT06 := LIMIT(0.0, PT06 / SCALE * 100.0, 100.0); PL06 := PLA[6]; HL06 := (HOUR + 6) MOD 24;
IF 7 < KNOWN THEN PT07 := TO_REAL(A[7]) / 100.0; ELSE PT07 := 0.0; END_IF; BT07 := LIMIT(0.0, PT07 / SCALE * 100.0, 100.0); PL07 := PLA[7]; HL07 := (HOUR + 7) MOD 24;
IF 8 < KNOWN THEN PT08 := TO_REAL(A[8]) / 100.0; ELSE PT08 := 0.0; END_IF; BT08 := LIMIT(0.0, PT08 / SCALE * 100.0, 100.0); PL08 := PLA[8]; HL08 := (HOUR + 8) MOD 24;
IF 9 < KNOWN THEN PT09 := TO_REAL(A[9]) / 100.0; ELSE PT09 := 0.0; END_IF; BT09 := LIMIT(0.0, PT09 / SCALE * 100.0, 100.0); PL09 := PLA[9]; HL09 := (HOUR + 9) MOD 24;
IF 10 < KNOWN THEN PT10 := TO_REAL(A[10]) / 100.0; ELSE PT10 := 0.0; END_IF; BT10 := LIMIT(0.0, PT10 / SCALE * 100.0, 100.0); PL10 := PLA[10]; HL10 := (HOUR + 10) MOD 24;
IF 11 < KNOWN THEN PT11 := TO_REAL(A[11]) / 100.0; ELSE PT11 := 0.0; END_IF; BT11 := LIMIT(0.0, PT11 / SCALE * 100.0, 100.0); PL11 := PLA[11]; HL11 := (HOUR + 11) MOD 24;
IF 12 < KNOWN THEN PT12 := TO_REAL(A[12]) / 100.0; ELSE PT12 := 0.0; END_IF; BT12 := LIMIT(0.0, PT12 / SCALE * 100.0, 100.0); PL12 := PLA[12]; HL12 := (HOUR + 12) MOD 24;
IF 13 < KNOWN THEN PT13 := TO_REAL(A[13]) / 100.0; ELSE PT13 := 0.0; END_IF; BT13 := LIMIT(0.0, PT13 / SCALE * 100.0, 100.0); PL13 := PLA[13]; HL13 := (HOUR + 13) MOD 24;
IF 14 < KNOWN THEN PT14 := TO_REAL(A[14]) / 100.0; ELSE PT14 := 0.0; END_IF; BT14 := LIMIT(0.0, PT14 / SCALE * 100.0, 100.0); PL14 := PLA[14]; HL14 := (HOUR + 14) MOD 24;
IF 15 < KNOWN THEN PT15 := TO_REAL(A[15]) / 100.0; ELSE PT15 := 0.0; END_IF; BT15 := LIMIT(0.0, PT15 / SCALE * 100.0, 100.0); PL15 := PLA[15]; HL15 := (HOUR + 15) MOD 24;
IF 16 < KNOWN THEN PT16 := TO_REAL(A[16]) / 100.0; ELSE PT16 := 0.0; END_IF; BT16 := LIMIT(0.0, PT16 / SCALE * 100.0, 100.0); PL16 := PLA[16]; HL16 := (HOUR + 16) MOD 24;
IF 17 < KNOWN THEN PT17 := TO_REAL(A[17]) / 100.0; ELSE PT17 := 0.0; END_IF; BT17 := LIMIT(0.0, PT17 / SCALE * 100.0, 100.0); PL17 := PLA[17]; HL17 := (HOUR + 17) MOD 24;
IF 18 < KNOWN THEN PT18 := TO_REAL(A[18]) / 100.0; ELSE PT18 := 0.0; END_IF; BT18 := LIMIT(0.0, PT18 / SCALE * 100.0, 100.0); PL18 := PLA[18]; HL18 := (HOUR + 18) MOD 24;
IF 19 < KNOWN THEN PT19 := TO_REAL(A[19]) / 100.0; ELSE PT19 := 0.0; END_IF; BT19 := LIMIT(0.0, PT19 / SCALE * 100.0, 100.0); PL19 := PLA[19]; HL19 := (HOUR + 19) MOD 24;
IF 20 < KNOWN THEN PT20 := TO_REAL(A[20]) / 100.0; ELSE PT20 := 0.0; END_IF; BT20 := LIMIT(0.0, PT20 / SCALE * 100.0, 100.0); PL20 := PLA[20]; HL20 := (HOUR + 20) MOD 24;
IF 21 < KNOWN THEN PT21 := TO_REAL(A[21]) / 100.0; ELSE PT21 := 0.0; END_IF; BT21 := LIMIT(0.0, PT21 / SCALE * 100.0, 100.0); PL21 := PLA[21]; HL21 := (HOUR + 21) MOD 24;
IF 22 < KNOWN THEN PT22 := TO_REAL(A[22]) / 100.0; ELSE PT22 := 0.0; END_IF; BT22 := LIMIT(0.0, PT22 / SCALE * 100.0, 100.0); PL22 := PLA[22]; HL22 := (HOUR + 22) MOD 24;
IF 23 < KNOWN THEN PT23 := TO_REAL(A[23]) / 100.0; ELSE PT23 := 0.0; END_IF; BT23 := LIMIT(0.0, PT23 / SCALE * 100.0, 100.0); PL23 := PLA[23]; HL23 := (HOUR + 23) MOD 24;

(* the load: a storage tank heater. Without usable prices it runs as if there were no price control. *)
SP_ACT := SP;
IF MODE = 0 THEN
    RELEASE := FALSE; REASON := 0;
ELSIF MODE = 1 THEN
    RELEASE := TRUE; REASON := 1;
ELSIF NOT VALID THEN
    RELEASE := TRUE; REASON := 6;
ELSIF PRICE <= LIM_LOW THEN
    RELEASE := TRUE; REASON := 3; SP_ACT := SP_BOOST;
ELSIF PRICE > LIM_HIGH THEN
    RELEASE := FALSE; REASON := 4;
ELSIF (STRAT = 0 AND IN_BLOCK) OR (STRAT = 1 AND RANK >= 1 AND RANK <= N_CHEAP) THEN
    RELEASE := TRUE; REASON := 2;
ELSE
    RELEASE := FALSE; REASON := 5;
END_IF;
IF MODE = 2 AND NOT RELEASE AND TANK < T_MIN THEN RELEASE := TRUE; REASON := 7; END_IF;

IF TANK < SP_ACT - 3.0 THEN TH := TRUE; END_IF;
IF TANK >= SP_ACT THEN TH := FALSE; END_IF;
HEAT := RELEASE AND TH;

(* simulated tank: heats 0.6 K/min, loses 0.15 K/min *)
IF SIM_FAST THEN SIMK := 20.0; ELSE SIMK := 1.0; END_IF;
IF HEAT THEN TANK := TANK + 0.01 * TS * SIMK; END_IF;
TANK := TANK - 0.0025 * TS * SIMK;
IF TANK < 10.0 THEN TANK := 10.0; END_IF;

(* alarm: no usable price for 10 s (the beat watchdog itself takes 60 s) *)
IF VALID THEN AL_T := 0.0; ELSIF AL_T < 100.0 THEN AL_T := AL_T + TS; END_IF;
AL_NOPRICE := AL_T >= 10.0;
