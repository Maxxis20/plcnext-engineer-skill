IF STRAT < 0 OR STRAT > 1 THEN STRAT := 0; END_IF;
NB := N_BLOCK * SPH;

(* the plan's clock: one step per slot. A jump of the clock (not the next slot) throws the plan away. *)
IF VALID AND SLOT <> SLOT_OLD THEN
