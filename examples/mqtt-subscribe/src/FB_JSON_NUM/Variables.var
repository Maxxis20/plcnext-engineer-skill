VAR_INPUT
    BUF_LEN : INT;                          (* bytes in BUF *)
    KEY : STRING;                           (* e.g. 'temperature' *)
END_VAR
VAR_IN_OUT
    BUF : ARRAY[0..2047] OF BYTE;           (* JSON text; in/out so the 2 KB are not copied on every call *)
END_VAR
VAR_OUTPUT
    FOUND : BOOL;                           (* "KEY": found and followed by a number *)
    VALUE : REAL;                           (* keeps its last value while FOUND is FALSE *)
END_VAR
VAR
    KB : ARRAY[0..63] OF BYTE;              (* search key as bytes: "KEY" with both quotes *)
    KLEN : INT;
    KEY_LAST : STRING;
    KEY_BUILT : BOOL;
    ASCII_TAB : STRING[100];                (* characters 40..126, filled in the code *)
    CB : BYTE;
    N : INT;
    I : INT;
    J : INT;
    S : INT;
    P : INT;
    C : INT;
    HIT : BOOL;
    MATCH : BOOL;
    GOING : BOOL;
    IS_NEG : BOOL;
    FRAC : BOOL;
    DIGITS : INT;
    V : REAL;
    SCALE : REAL;
END_VAR
